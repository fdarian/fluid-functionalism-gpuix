{
	"extends": "@total-typescript/tsconfig/bundler/no-dom/app",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noErrorTruncation": true,
		"noUncheckedIndexedAccess": false,
		"jsx": "preserve",
		"jsxImportSource": "@ghia/solid",
		"types": ["bun"],
		"paths": { "#/*": ["./src/*"] }
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"scripts/**/*.tsx",
		"tsdown.config.ts"
	]
}
