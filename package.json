{
	"name": "fluid-functionalism-gpuix",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Experiment: fluidfunctionalism.com's Button, Combobox and Sidebar (with fluid hover) ported to @gpuix/solid.",
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"start": "bun --hot src/main.tsx",
		"check": "pnpm check:type && pnpm check:scenarios",
		"check:type": "tsc",
		"check:scenarios": "bun scripts/run-scenarios.ts",
		"screenshots": "bun scripts/run-screenshots.ts",
		"perf": "bun scripts/perf.tsx",
		"format": "biome check --write"
	},
	"dependencies": {
		"@gpuix/native": "link:../gpuix/packages/native",
		"@gpuix/solid": "file:../gpuix/packages/solid",
		"base-ui-solid-gpuix": "link:../base-ui-solid-gpuix",
		"solid-js": "1.9.15"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@total-typescript/tsconfig": "latest",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
