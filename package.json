{
	"name": "ghia-fluid-functionalism",
	"version": "0.0.0",
	"type": "module",
	"description": "Fluid Functionalism's components, demos and pages drawn natively on ghia (Solid on GPUI), run with npx.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/ghia-fluid-functionalism.git"
	},
	"license": "MIT",
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./lib/*.d.ts",
			"import": "./lib/*.js"
		}
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"start": "bun --hot src/main.tsx",
		"build": "bun scripts/build.ts",
		"check": "pnpm check:type && pnpm check:scenarios",
		"check:type": "tsc",
		"check:scenarios": "bun scripts/run-scenarios.ts",
		"screenshots": "bun scripts/run-screenshots.ts",
		"perf": "bun scripts/perf.tsx",
		"footprint": "bun scripts/footprint.tsx",
		"format": "biome check --write",
		"ci:version": "changeset version",
		"ci:release": "bun scripts/release-build.ts && changeset publish",
		"prepare": "tsdown",
		"build:lib": "tsdown"
	},
	"files": [
		"dist/cli.js",
		"dist/checksums.json",
		"lib",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"bin": {
			"ghia-fluid-functionalism": "./dist/cli.js"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@changesets/cli": "3.0.3",
		"@ghia/native": "0.11.1",
		"@ghia/solid": "0.11.1",
		"@total-typescript/tsconfig": "latest",
		"@types/bun": "^1.4.2",
		"ghia-base-ui": "0.1.1",
		"rolldown-plugin-solid": "0.2.1",
		"solid-js": "1.9.15",
		"tsdown": "0.23.5",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@ghia/native": "0.11.1",
		"@ghia/solid": "0.11.1",
		"ghia-base-ui": "0.1.1",
		"solid-js": "1.9.15"
	}
}
