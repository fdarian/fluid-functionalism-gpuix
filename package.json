{
	"name": "fluid-functionalism-gpuix",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Experiment: fluidfunctionalism.com's Button, Combobox and Sidebar (with fluid hover) ported to @ghia/solid.",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"start": "bun --hot src/main.tsx",
		"build": "bun scripts/build.ts",
		"check": "pnpm check:type && pnpm check:scenarios",
		"check:type": "tsc",
		"check:scenarios": "bun scripts/run-scenarios.ts",
		"screenshots": "bun scripts/run-screenshots.ts",
		"perf": "bun scripts/perf.tsx",
		"footprint": "bun scripts/footprint.tsx",
		"format": "biome check --write"
	},
	"dependencies": {
		"@ghia/native": "0.11.1",
		"@ghia/solid": "0.11.1",
		"ghia-base-ui": "0.1.0",
		"solid-js": "1.9.15"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@total-typescript/tsconfig": "latest",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
